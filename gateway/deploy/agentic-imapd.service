[Unit]
Description=agentic-inbox IMAP/SMTP gateway
Documentation=https://github.com/crumrine/agentic-inbox/blob/main/gateway/README.md
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=simple
User=agentic-imapd
Group=agentic-imapd
EnvironmentFile=/etc/agentic-imapd/agentic-imapd.env
ExecStart=/usr/local/bin/agentic-imapd
Restart=on-failure
RestartSec=5s

# Hardening. agentic-imapd is stateless (no mail, no database, no durable
# state on disk) so it needs no writable paths at all beyond the TLS cert
# directory, which it only reads.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The default listen ports ARE privileged: 993 for IMAP, plus 465 and 587
# for submission, all of which the service binds when the corresponding
# AGENTIC_*_ADDR is left unset. They are the ports mail clients try, and
# several clients offer no way to choose another. Running unprivileged with
# an empty capability set would fail bind(2) with EACCES on a default
# install and restart-loop, so CAP_NET_BIND_SERVICE is granted here.
#
# It is the whole grant: the bounding set allows nothing else, so the
# service can bind a low port and do nothing further a root process could.
# Setting high ports in AGENTIC_IMAP_ADDR, AGENTIC_SMTP_ADDR and
# AGENTIC_SMTP_STARTTLS_ADDR and emptying both lines again is a supported
# hardening step, at the cost of every client needing non-default ports
# configured by hand, which some clients cannot do at all.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
