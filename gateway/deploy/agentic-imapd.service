[Unit]
Description=agentic-inbox IMAP/SMTP gateway
Documentation=https://github.com/crumrine/agentic-inbox/blob/main/gateway/README.md
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=simple
User=agentic-imapd
Group=agentic-imapd
EnvironmentFile=/etc/agentic-imapd/agentic-imapd.env
ExecStart=/usr/local/bin/agentic-imapd
Restart=on-failure
RestartSec=5s

# Hardening. agentic-imapd is stateless (no mail, no database, no durable
# state on disk) so it needs no writable paths at all beyond the TLS cert
# directory, which it only reads.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The default listen port IS privileged: config.DefaultIMAPPort is 993 (the
# IANA imaps port), which is what a mail client tries first and what the
# service binds when AGENTIC_IMAP_ADDR is left unset. Running unprivileged
# with an empty capability set would fail bind(2) with EACCES on a default
# install and restart-loop, so CAP_NET_BIND_SERVICE is granted here.
#
# It is the whole grant: the bounding set allows nothing else, so the
# service can bind a low port and do nothing further a root process could.
# Setting a high port in AGENTIC_IMAP_ADDR and emptying both lines again is
# a supported hardening step, at the cost of every client needing a
# non-default port configured by hand.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
