# Example environment file for agentic-imapd. Copy to
# /etc/agentic-imapd/agentic-imapd.env, fill in real values, and
# `chmod 600` it (it holds a Cloudflare Access service token).
#
# See ../README.md for the full description of each variable.

# Base URL of the Worker backend.
AGENTIC_INBOX_URL=https://mail.example.com

# Cloudflare Access service token used to authenticate every request to the
# Worker. Create one under Zero Trust > Access > Service Auth.
AGENTIC_ACCESS_CLIENT_ID=changeme.access
AGENTIC_ACCESS_CLIENT_SECRET=changeme

# Listen address. Leave unset to auto-detect a Tailscale (100.64.0.0/10)
# interface address on port 993; set explicitly if auto-detection picks the
# wrong interface or you run more than one Tailscale interface.
#
# 993 is privileged, so the shipped systemd unit grants the service
# CAP_NET_BIND_SERVICE. If you set a port above 1024 here you can drop that
# capability from the unit (CapabilityBoundingSet= and AmbientCapabilities=
# both empty), at the cost of configuring the port by hand in every client.
#AGENTIC_IMAP_ADDR=100.64.1.2:993

# Submission listen addresses. Two front doors onto the same logic:
#   465  implicit TLS
#   587  mandatory STARTTLS, the RFC 6409 port most clients default to
#        (iOS Mail has no outgoing port field and only ever tries 587)
#
# Leave either unset to auto-detect the same Tailscale interface on its
# default port; set either to "off" to disable that listener. Both are
# independently optional and neither can stop IMAP from starting. Both
# ports are privileged, and the unit already grants CAP_NET_BIND_SERVICE.
#AGENTIC_SMTP_ADDR=100.64.1.2:465
#AGENTIC_SMTP_STARTTLS_ADDR=100.64.1.2:587

# TLS certificate/key from `tailscale cert <magicdns-name>`.
AGENTIC_TLS_CERT=/var/lib/agentic-imapd/tls/cert.pem
AGENTIC_TLS_KEY=/var/lib/agentic-imapd/tls/key.pem

# debug | info | warn | error
AGENTIC_LOG_LEVEL=info

# Safety interlock override. Leave unset/false. Only set to true if you
# understand you are exposing IMAP to a non-Tailscale network.
#AGENTIC_ALLOW_PUBLIC_BIND=false
